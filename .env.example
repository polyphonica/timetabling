# Postgres connection string. For local dev, see README for how the
# "timetabling_app" role/database was created on the local Postgres instance.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/timetabling_dev

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Absolute path where uploaded documents (e.g. session sheet music PDFs)
# are stored on disk. In production this MUST be outside the git-managed
# project directory so a deploy/git pull never touches it, e.g.
# /home/<user>/timetabling-uploads. For local dev, a repo-relative path
# like ./uploads is fine.
UPLOADS_DIR=./uploads
